{
  "dependencies": {
    "@nestjs/mapped-types": "*"
  },
  "name": "rewire",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "sam:build": "pnpm --filter @rewire/api exec sam build",
    "sam:validate": "pnpm --filter @rewire/api exec sam validate --lint",
    "sam:deploy": "pnpm --filter @rewire/api exec sam deploy",
    "sam:deploy:prod": "pnpm --filter @rewire/api exec sam deploy --config-env production",
    "sam:local": "pnpm --filter @rewire/api exec sam local invoke AiWorkerFunction",
    "sam:logs": "pnpm --filter @rewire/api exec sam logs --stack-name rewire-ai-stack --tail",
    "vercel:link": "vercel link",
    "vercel:deploy": "vercel",
    "vercel:deploy:prod": "vercel --prod",
    "vercel:env:push:prod": "node scripts/vercel-env-sync.mjs --env=production",
    "vercel:env:push:preview": "node scripts/vercel-env-sync.mjs --env=preview",
    "vercel:env:pull:prod": "vercel env pull apps/web/.env.production.local --environment=production --yes",
    "vercel:env:pull:preview": "vercel env pull apps/web/.env.preview.local --environment=preview --yes",
    "vercel:env:ls": "vercel env ls",
    "db:generate": "pnpm --filter @rewire/database db:generate",
    "db:push": "pnpm --filter @rewire/database db:push",
    "db:push:prod": "pnpm --filter @rewire/database db:push:prod",
    "db:migrate": "pnpm --filter @rewire/database db:migrate",
    "db:studio": "pnpm --filter @rewire/database db:studio",
    "db:studio:prod": "pnpm --filter @rewire/database db:studio:prod",
    "db:build": "pnpm --filter @rewire/database build",
    "db:studio:dev": "prisma studio --schema packages/database/prisma/dev.db.schema.prisma"
  },
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "turbo": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "unrs-resolver",
      "better-sqlite3"
    ]
  }
}